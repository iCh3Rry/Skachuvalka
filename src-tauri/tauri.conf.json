{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VideoGrab",
  "version": "1.0.1",
  "identifier": "com.videograb.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VideoGrab",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZGNUVBRDZFQkRDMEEwRDEKUldUUm9NQzlicTFlYitiZllIR243NEhuMnFqVjFKMWdsanFyV01mS3UySlQxL1lVWCtGQnJERmgK",
      "endpoints": [
        "https://YOUR-UPDATE-SERVER.com/updates/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": [
      "resources/yt-dlp-bundled*",
      "resources/ffmpeg-bundled*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}